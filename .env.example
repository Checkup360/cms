POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=checkup360
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

PAYLOAD_SECRET=YOUR_SECRET_HERE

# Shared with the FastAPI backend (AUTH_SECRET) so the CMS can verify the same JWTs.
AUTH_SECRET=<same-secret-as-backend>
# Base URL of the FastAPI backend (used to resolve the user's organization via /auth/me).
BACKEND_URL=http://localhost:8000
# Name of the httponly cookie the backend issues (fastapi-users CookieTransport).
AUTH_COOKIE_NAME=auth
# Origin of the existing web frontend (its /login is the real login). Dev default: web app on 5173.
PUBLIC_WEB_ORIGIN=http://localhost:5173
